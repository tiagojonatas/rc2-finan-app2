<div class="flex justify-center items-start min-h-[60vh] pt-8">
  <div class="w-full max-w-2xl">
    <div class="bg-slate-900/80 backdrop-blur border border-slate-800 rounded-2xl p-8 shadow-lg">
      <h2 class="text-2xl font-semibold text-white mb-6">Perfil</h2>

      <% if (error) { %>
        <div class="mb-4 text-red-400 text-sm bg-red-500/10 border border-red-500/20 p-3 rounded-lg"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="mb-4 text-emerald-300 text-sm bg-emerald-500/10 border border-emerald-500/20 p-3 rounded-lg"><%= success %></div>
      <% } %>

      <form action="/perfil" method="POST" class="space-y-5">
        <div>
          <label for="name" class="text-sm text-slate-400">Nome</label>
          <input id="name" name="name" type="text" required value="<%= user && user.name ? user.name : '' %>" class="w-full mt-1 bg-slate-800 border border-slate-700 rounded-lg px-3 h-12 text-white focus:outline-none focus:ring-2 focus:ring-emerald-500 transition" />
        </div>

        <div>
          <label for="email" class="text-sm text-slate-400">Email</label>
          <input id="email" name="email" type="email" required value="<%= user && user.email ? user.email : '' %>" class="w-full mt-1 bg-slate-800 border border-slate-700 rounded-lg px-3 h-12 text-white focus:outline-none focus:ring-2 focus:ring-emerald-500 transition" />
        </div>

        <button type="submit" class="w-full h-12 rounded-lg bg-[#00C9A7] hover:bg-[#009e83] text-white font-semibold transition-all duration-200">
          Salvar alteracoes
        </button>
      </form>
    </div>
  </div>
</div>
